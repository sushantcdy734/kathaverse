# PostgreSQL connection string (create the database first)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/nepalistory?schema=public"
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Optional initial admin provisioning. Used only if this email does not exist.
# Use a unique password with at least 12 characters; never commit server/.env.
ADMIN_EMAIL=""
ADMIN_USERNAME="siteadmin"
ADMIN_PASSWORD=""
